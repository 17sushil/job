# Copy to .env.local (git-ignored) and restart `pnpm dev`.
#
# ─── backend API (browser-side; proxied by the rewrites in next.config.js) ────
# Laptop / sandbox: http://localhost:4000
# Render frontend:  https://<your-backend-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── ATS microservice (friend's parser) ──────────────────────────────────────
# Browser-side helpers (editor re-parse). Only reachable where the service
# runs - e.g. http://127.0.0.1:8000 while it lives on your laptop.
# Upload extraction itself is server-side: see apps/backend/.env ATS_* keys.
NEXT_PUBLIC_ATS_ENDPOINT=http://127.0.0.1:8000/v1/format
NEXT_PUBLIC_ATS_PARSE_ENDPOINT=http://127.0.0.1:8000/v1/parse
NEXT_PUBLIC_ATS_API_KEY=abc
# NEXT_PUBLIC_ATS_MAX_PAGES=2

# Reserved for future service-hosted canvas drafts (not read by code yet):
# NEXT_PUBLIC_ATS_DRAFT_ENDPOINT=http://127.0.0.1:8000/v1/resume/{jobId}/canvas
