{
  "name": "@jobdev/backend",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "migration:generate": "tsx node_modules/typeorm/cli.js -d src/database/data-source.ts migration:generate",
    "migration:run": "tsx node_modules/typeorm/cli.js -d src/database/data-source.ts migration:run",
    "migration:revert": "tsx node_modules/typeorm/cli.js -d src/database/data-source.ts migration:revert",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^2.1.8"
  }
}
