{
  "name": "@jobdev/backend",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "migration:generate": "tsx node_modules/typeorm/cli.js -d src/database/data-source.ts migration:generate",
    "migration:run": "tsx node_modules/typeorm/cli.js -d src/database/data-source.ts migration:run",
    "migration:revert": "tsx node_modules/typeorm/cli.js -d src/database/data-source.ts migration:revert",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^2.1.8"
  }
}
